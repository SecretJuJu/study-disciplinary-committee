# Copy the exports into your shell, replace every placeholder, then run:
# bash scripts/bootstrap-deployment.sh

export AWS_PROFILE='administrator-profile'
export AWS_REGION='ap-northeast-2'
export GITHUB_REPOSITORY='owner/repository'

export OPENAI_API_KEY='replace-me'
export DISCORD_APPLICATION_ID='00000000000000000'
export DISCORD_PUBLIC_KEY='replace-with-64-character-hex-public-key'
export DISCORD_BOT_TOKEN='replace-me'
export DISCORD_GUILD_ID='00000000000000000'
export DISCORD_DEBUG_CHANNEL_ID='00000000000000000'
export BUDGET_ALERT_EMAIL='you@example.com'

# Use a long, unique value and keep a recovery copy outside this repository.
export PULUMI_CONFIG_PASSPHRASE='replace-with-a-long-random-passphrase'

# Defaults shown for clarity; these can be omitted.
export PULUMI_STACK='prod'
export PULUMI_ENVIRONMENT='prod'
export MONTHLY_BUDGET_USD='3'
export DISCORD_COMMAND_SCOPE='guild'
